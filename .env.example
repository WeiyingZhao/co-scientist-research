# Geospatial AI Co-Scientist Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# LLM provider: openai, anthropic, azure_openai, local
GEO_SCIENTIST_LLM_PROVIDER=openai

# OpenAI Configuration
GEO_SCIENTIST_OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration (optional)
GEO_SCIENTIST_ANTHROPIC_API_KEY=your-anthropic-api-key

# Azure OpenAI Configuration (optional)
GEO_SCIENTIST_AZURE_OPENAI_API_KEY=
GEO_SCIENTIST_AZURE_OPENAI_ENDPOINT=

# =============================================================================
# Model Configuration
# =============================================================================

# Models for different agents
GEO_SCIENTIST_GENERATION_MODEL=gpt-4-turbo-preview
GEO_SCIENTIST_REFLECTION_MODEL=gpt-4-turbo-preview
GEO_SCIENTIST_RANKING_MODEL=gpt-4-turbo-preview
GEO_SCIENTIST_FAST_MODEL=gpt-3.5-turbo

# Model parameters
GEO_SCIENTIST_TEMPERATURE=0.7
GEO_SCIENTIST_MAX_TOKENS=4096

# =============================================================================
# Literature Search Configuration
# =============================================================================

# Semantic Scholar API key (optional, for higher rate limits)
GEO_SCIENTIST_SEMANTIC_SCHOLAR_API_KEY=

# Maximum search results to retrieve
GEO_SCIENTIST_SEARCH_RESULTS_LIMIT=20

# =============================================================================
# Vector Store Configuration
# =============================================================================

# Vector store type: chroma, faiss
GEO_SCIENTIST_VECTOR_STORE_TYPE=chroma

# Embedding model
GEO_SCIENTIST_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB persistence directory
GEO_SCIENTIST_CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# =============================================================================
# Workflow Configuration
# =============================================================================

# Maximum generate-refine iterations
GEO_SCIENTIST_MAX_ITERATIONS=3

# Hypotheses to generate per iteration
GEO_SCIENTIST_HYPOTHESES_PER_ITERATION=5

# Top hypotheses to evolve
GEO_SCIENTIST_TOP_HYPOTHESES_TO_EVOLVE=3

# Pairwise comparisons for ranking
GEO_SCIENTIST_RANKING_COMPARISONS=10

# =============================================================================
# Elo Rating Configuration
# =============================================================================

GEO_SCIENTIST_INITIAL_ELO_SCORE=1000.0
GEO_SCIENTIST_ELO_K_FACTOR=32.0

# =============================================================================
# Human-in-the-Loop Checkpoints
# =============================================================================

GEO_SCIENTIST_CHECKPOINT_AFTER_GENERATION=false
GEO_SCIENTIST_CHECKPOINT_AFTER_RANKING=false
GEO_SCIENTIST_CHECKPOINT_BEFORE_FINAL=true

# =============================================================================
# Monitoring and Logging
# =============================================================================

# LangSmith for tracing (optional)
GEO_SCIENTIST_LANGSMITH_API_KEY=
GEO_SCIENTIST_LANGSMITH_PROJECT=geospatial-co-scientist

# Log level: DEBUG, INFO, WARNING, ERROR
GEO_SCIENTIST_LOG_LEVEL=INFO

# =============================================================================
# Caching
# =============================================================================

GEO_SCIENTIST_ENABLE_CACHING=true
GEO_SCIENTIST_CACHE_TTL_SECONDS=3600

# =============================================================================
# Data Analysis
# =============================================================================

# Enable code execution for data analysis (use with caution)
GEO_SCIENTIST_ENABLE_CODE_EXECUTION=false
GEO_SCIENTIST_SANDBOX_TYPE=docker

# =============================================================================
# API Server
# =============================================================================

GEO_SCIENTIST_API_HOST=0.0.0.0
GEO_SCIENTIST_API_PORT=8000
